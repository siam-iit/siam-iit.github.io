{"title":"---","markdown":{"headingText":"---","containsRefs":false,"markdown":"\n```{=html}\n<div class=\"site-shell\">\n\n  <header class=\"topbar\">\n    <a class=\"wordmark\" href=\"./\">SIAM / IIT</a>\n\n    <nav class=\"main-nav\" aria-label=\"Main navigation\">\n      <a href=\"./tea/\">DODGSON'S</a>\n      <a href=\"./events.html\">EVENTS</a>\n      <a href=\"./people.html\">PEOPLE</a>\n      <a href=\"./siam.html\">WHAT IS SIAM?</a>\n      <a class=\"join-link\" href=\"./join.html\">JOIN ↗</a>\n    </nav>\n  </header>\n\n\n  <!-- =====================================================\n       FIG. 01 / HERO\n       ===================================================== -->\n\n  <section class=\"hero\">\n\n    <div class=\"moire-wrap hero-surface\">\n\n      <canvas id=\"moire-canvas\"></canvas>\n\n      <div class=\"hero-overlay\">\n\n        <div class=\"hero-copy\">\n\n          <div class=\"fig-label\">\n            FIG. 01 / SIAM @ ILLINOIS TECH\n          </div>\n\n          <h1>\n            WE LIKE<br>\n            HARD PROBLEMS.\n          </h1>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </section>\n\n\n  <!-- =====================================================\n       FIG. 02 / DODGSON'S\n       ===================================================== -->\n\n  <section class=\"rule-section split\">\n\n    <div>\n\n      <div class=\"fig-label\">\n        FIG. 02 / WEEKLY / THURSDAYS\n      </div>\n\n      <h2>\n        DODGSON'S<br>\n        TEA PARTY\n      </h2>\n\n    </div>\n\n    <div class=\"body-copy\">\n\n      <p>\n        A weekly gathering for mathematics,\n        puzzles, conversation, and tea.\n      </p>\n\n      <p class=\"small-caps\">\n        12:45 PM / PS 255\n      </p>\n\n      <a class=\"text-link\" href=\"./tea/\">\n        ENTER THE ARCHIVE ↗\n      </a>\n\n    </div>\n\n  </section>\n<!-- =====================================================\n     FIG. 03 / SIAM NETWORK\n     ===================================================== -->\n\n<section class=\"network-section\">\n\n  <div class=\"fig-label\">\n    FIG. 03 / CHAPTER NETWORK\n  </div>\n\n  <h2>\n    THE SIAM NETWORK\n  </h2>\n\n\n  <div class=\"chapter-graph\">\n\n    <svg\n      class=\"network-svg\"\n      viewBox=\"0 0 1000 430\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      role=\"img\"\n      aria-labelledby=\"network-title network-desc\"\n    >\n\n      <title id=\"network-title\">\n        Illinois SIAM student chapter network\n      </title>\n\n      <desc id=\"network-desc\">\n        Illinois Tech, Loyola, Northwestern, and UIUC\n        shown within a larger SIAM student chapter network.\n      </desc>\n\n\n      <!-- ==================================================\n           EXTENDED NETWORK / FADED CONTEXT\n           ================================================== -->\n\n      <g class=\"ghost-network\">\n\n\n        <!-- FAINT BACKGROUND EDGES -->\n\n        <g class=\"ghost-edges ghost-edges-faint\">\n\n          <line x1=\"75\"  y1=\"120\" x2=\"180\" y2=\"210\" />\n          <line x1=\"75\"  y1=\"120\" x2=\"245\" y2=\"85\" />\n\n          <line x1=\"245\" y1=\"85\"  x2=\"455\" y2=\"230\" />\n          <line x1=\"245\" y1=\"85\"  x2=\"365\" y2=\"55\" />\n\n          <line x1=\"365\" y1=\"55\"  x2=\"690\" y2=\"115\" />\n          <line x1=\"690\" y1=\"115\" x2=\"835\" y2=\"72\" />\n\n          <line x1=\"835\" y1=\"72\"  x2=\"930\" y2=\"145\" />\n          <line x1=\"930\" y1=\"145\" x2=\"810\" y2=\"255\" />\n\n          <line x1=\"925\" y1=\"330\" x2=\"810\" y2=\"255\" />\n          <line x1=\"925\" y1=\"330\" x2=\"735\" y2=\"360\" />\n\n          <line x1=\"735\" y1=\"360\" x2=\"500\" y2=\"370\" />\n          <line x1=\"735\" y1=\"360\" x2=\"625\" y2=\"305\" />\n\n          <line x1=\"625\" y1=\"305\" x2=\"455\" y2=\"230\" />\n\n          <line x1=\"500\" y1=\"370\" x2=\"325\" y2=\"350\" />\n          <line x1=\"325\" y1=\"350\" x2=\"180\" y2=\"210\" />\n\n          <line x1=\"325\" y1=\"350\" x2=\"120\" y2=\"325\" />\n          <line x1=\"120\" y1=\"325\" x2=\"45\"  y2=\"265\" />\n\n        </g>\n\n\n        <!-- NEAR-FIELD CONTEXT -->\n\n        <g class=\"ghost-edges ghost-edges-near\">\n\n          <line x1=\"180\" y1=\"210\" x2=\"300\" y2=\"170\" />\n          <line x1=\"300\" y1=\"170\" x2=\"455\" y2=\"230\" />\n\n          <line x1=\"455\" y1=\"230\" x2=\"565\" y2=\"165\" />\n          <line x1=\"565\" y1=\"165\" x2=\"690\" y2=\"115\" />\n\n          <line x1=\"690\" y1=\"115\" x2=\"760\" y2=\"185\" />\n          <line x1=\"760\" y1=\"185\" x2=\"810\" y2=\"255\" />\n\n          <line x1=\"455\" y1=\"230\" x2=\"590\" y2=\"285\" />\n          <line x1=\"590\" y1=\"285\" x2=\"810\" y2=\"255\" />\n\n          <line x1=\"590\" y1=\"285\" x2=\"500\" y2=\"370\" />\n\n        </g>\n\n\n        <!-- FADED VERTICES -->\n\n        <g class=\"ghost-nodes ghost-nodes-faint\">\n\n          <circle cx=\"75\"  cy=\"120\" r=\"4\" />\n          <circle cx=\"245\" cy=\"85\"  r=\"4\" />\n          <circle cx=\"365\" cy=\"55\"  r=\"3.5\" />\n\n          <circle cx=\"835\" cy=\"72\"  r=\"4\" />\n          <circle cx=\"930\" cy=\"145\" r=\"3.5\" />\n\n          <circle cx=\"925\" cy=\"330\" r=\"4\" />\n          <circle cx=\"735\" cy=\"360\" r=\"4\" />\n\n          <circle cx=\"325\" cy=\"350\" r=\"4\" />\n          <circle cx=\"120\" cy=\"325\" r=\"3.5\" />\n          <circle cx=\"45\"  cy=\"265\" r=\"3\" />\n\n        </g>\n\n\n        <!-- NEARER FADED VERTICES -->\n\n        <g class=\"ghost-nodes ghost-nodes-near\">\n\n          <circle cx=\"300\" cy=\"170\" r=\"4.5\" />\n          <circle cx=\"565\" cy=\"165\" r=\"4.5\" />\n          <circle cx=\"760\" cy=\"185\" r=\"4.5\" />\n          <circle cx=\"590\" cy=\"285\" r=\"4.5\" />\n          <circle cx=\"625\" cy=\"305\" r=\"4\" />\n\n        </g>\n\n      </g>\n\n\n      <!-- ==================================================\n           SIAM ORGANIZATIONAL CONNECTIONS\n           ================================================== -->\n\n      <g class=\"siam-edges\">\n\n        <line x1=\"180\" y1=\"210\" x2=\"500\" y2=\"370\" />\n        <line x1=\"455\" y1=\"230\" x2=\"500\" y2=\"370\" />\n        <line x1=\"690\" y1=\"115\" x2=\"500\" y2=\"370\" />\n        <line x1=\"810\" y1=\"255\" x2=\"500\" y2=\"370\" />\n\n      </g>\n\n\n      <!-- ==================================================\n           LOCAL CHAPTER CONNECTIONS\n           ================================================== -->\n\n      <g class=\"chapter-edges\">\n\n        <line x1=\"180\" y1=\"210\" x2=\"455\" y2=\"230\" />\n        <line x1=\"180\" y1=\"210\" x2=\"690\" y2=\"115\" />\n        <line x1=\"455\" y1=\"230\" x2=\"690\" y2=\"115\" />\n        <line x1=\"455\" y1=\"230\" x2=\"810\" y2=\"255\" />\n        <line x1=\"690\" y1=\"115\" x2=\"810\" y2=\"255\" />\n\n      </g>\n\n\n     <!-- ==================================================\n     NAMED CHAPTERS\n     ================================================== -->\n\n\n<!-- LOYOLA -->\n\n<a\n  href=\"https://loyolachicagosiam.github.io/\"\n  target=\"_blank\"\n  rel=\"noopener\"\n  class=\"network-node-link\"\n  aria-label=\"Visit Loyola University Chicago SIAM\"\n>\n  <g class=\"network-node\">\n\n    <circle cx=\"180\" cy=\"210\" r=\"7\" />\n\n    <text\n      x=\"180\"\n      y=\"238\"\n      text-anchor=\"middle\"\n    >\n      LOYOLA ↗\n    </text>\n\n  </g>\n</a>\n\n\n<!-- IIT -->\n\n<g class=\"network-node network-node-iit\">\n\n  <circle cx=\"455\" cy=\"230\" r=\"10\" />\n\n  <text\n    x=\"455\"\n    y=\"260\"\n    text-anchor=\"middle\"\n  >\n    IIT\n  </text>\n\n  <text\n    class=\"network-sub-label\"\n    x=\"455\"\n    y=\"279\"\n    text-anchor=\"middle\"\n  >\n    YOU ARE HERE\n  </text>\n\n</g>\n\n\n<!-- NORTHWESTERN -->\n\n<a\n  href=\"https://siam-northwestern.github.io/\"\n  target=\"_blank\"\n  rel=\"noopener\"\n  class=\"network-node-link\"\n  aria-label=\"Visit Northwestern SIAM\"\n>\n  <g class=\"network-node\">\n\n    <circle cx=\"690\" cy=\"115\" r=\"7\" />\n\n    <text\n      x=\"690\"\n      y=\"91\"\n      text-anchor=\"middle\"\n    >\n      NORTHWESTERN ↗\n    </text>\n\n  </g>\n</a>\n\n\n<!-- UIUC -->\n\n<a\n  href=\"https://one.illinois.edu/societyforindustrialandappliedmathematics/home/\"\n  target=\"_blank\"\n  rel=\"noopener\"\n  class=\"network-node-link\"\n  aria-label=\"Visit UIUC SIAM\"\n>\n  <g class=\"network-node\">\n\n    <circle cx=\"810\" cy=\"255\" r=\"7\" />\n\n    <text\n      x=\"810\"\n      y=\"284\"\n      text-anchor=\"middle\"\n    >\n      UIUC ↗\n    </text>\n\n  </g>\n</a>\n\n\n<!-- SIAM -->\n\n<a\n  href=\"https://www.siam.org/membership/individual-membership/student-membership/\"\n  target=\"_blank\"\n  rel=\"noopener\"\n  class=\"network-node-link\"\n  aria-label=\"Learn about SIAM student membership\"\n>\n  <g class=\"network-node\">\n\n    <circle cx=\"500\" cy=\"370\" r=\"8\" />\n\n    <text\n      x=\"500\"\n      y=\"400\"\n      text-anchor=\"middle\"\n    >\n      SIAM ↗\n    </text>\n\n  </g>\n</a>\n\n\n\n\n  <!-- ==================================================\n       NETWORK SCALE\n       ================================================== -->\n\n  <div class=\"vertex-count\">\n    |V| &gt; 175\n  </div>\n\n  <div class=\"vertex-caption\">\n    STUDENT CHAPTERS WORLDWIDE\n  </div>\n\n\n  <!-- ==================================================\n       CTA\n       ================================================== -->\n\n  <div class=\"network-cta\">\n\n    <a class=\"text-link\" href=\"./siam.html\">\n      WHY THAT MATTERS ↗\n    </a>\n\n  </div>\n\n</section>\n\n  <!-- =====================================================\n       FOOTER\n       ===================================================== -->\n\n  <footer class=\"site-footer\">\n\n    <span>\n      SIAM @ IIT / CHICAGO, IL\n    </span>\n\n    <div>\n      <a href=\"./archive.html\">ARCHIVE</a>\n      <a href=\"#\">INSTAGRAM ↗</a>\n      <a href=\"#\">LINKEDIN ↗</a>\n    </div>\n\n  </footer>\n\n</div>\n\n<script src=\"./fun.js?v=4\"></script>\n```","srcMarkdownNoYaml":""},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"freeze":"auto","echo":true,"output":true,"warning":true,"include":true,"keep-md":false,"keep-ipynb":false,"ipynb":null,"enabled":null,"daemon":null,"daemon-restart":false,"debug":false,"ipynb-filters":[],"ipynb-shell-interactivity":null,"plotly-connected":true,"engine":"markdown"},"render":{"keep-tex":false,"keep-typ":false,"keep-source":false,"keep-hidden":false,"prefer-html":false,"output-divs":true,"output-ext":"html","fig-align":"default","fig-pos":null,"fig-env":null,"code-fold":"none","code-overflow":"scroll","code-link":false,"code-line-numbers":false,"code-tools":false,"tbl-colwidths":"auto","merge-includes":true,"inline-includes":false,"preserve-yaml":false,"latex-auto-mk":true,"latex-auto-install":true,"latex-clean":true,"latex-min-runs":1,"latex-max-runs":10,"latex-makeindex":"makeindex","latex-makeindex-opts":[],"latex-tlmgr-opts":[],"latex-input-paths":[],"latex-output-dir":null,"link-external-icon":false,"link-external-newwindow":false,"self-contained-math":false,"format-resources":[],"notebook-links":true},"pandoc":{"standalone":true,"wrap":"none","default-image-extension":"png","to":"html","css":["styles.css"],"toc":false,"output-file":"index.html"},"language":{"toc-title-document":"Table of contents","toc-title-website":"On this page","related-formats-title":"Other Formats","related-notebooks-title":"Notebooks","source-notebooks-prefix":"Source","other-links-title":"Other Links","code-links-title":"Code Links","launch-dev-container-title":"Launch Dev Container","launch-binder-title":"Launch Binder","article-notebook-label":"Article Notebook","notebook-preview-download":"Download Notebook","notebook-preview-download-