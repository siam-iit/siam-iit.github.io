{"title":"---","markdown":{"headingText":"---","containsRefs":false,"markdown":"\n```{=html}\n<div class=\"site-shell\">\n\n  <header class=\"topbar\">\n    <a class=\"wordmark\" href=\"./\">SIAM / IIT</a>\n\n    <nav class=\"main-nav\" aria-label=\"Main navigation\">\n      <a href=\"./tea/\">DODGSON'S</a>\n      <a href=\"./events.html\">EVENTS</a>\n      <a href=\"./people.html\">PEOPLE</a>\n      <a href=\"./siam.html\">WHAT IS SIAM?</a>\n      <a class=\"join-link\" href=\"./join.html\">JOIN ↗</a>\n    </nav>\n  </header>\n\n\n  <!-- =====================================================\n       FIG. 01 / HERO\n       ===================================================== -->\n\n  <section class=\"hero\">\n\n    <div class=\"moire-wrap hero-surface\">\n\n      <canvas id=\"moire-canvas\"></canvas>\n\n      <div class=\"hero-overlay\">\n\n        <div class=\"hero-copy\">\n\n          <div class=\"fig-label\">\n            FIG. 01 / SIAM @ ILLINOIS TECH\n          </div>\n\n          <h1>\n            WE LIKE<br>\n            HARD PROBLEMS.\n          </h1>\n\n        </div>\n\n      </div>\n\n    </div>\n\n  </section>\n\n\n  <!-- =====================================================\n       FIG. 02 / DODGSON'S\n       ===================================================== -->\n\n  <section class=\"rule-section split\">\n\n    <div>\n\n      <div class=\"fig-label\">\n        FIG. 02 / WEEKLY / THURSDAYS\n      </div>\n\n      <h2>\n        DODGSON'S<br>\n        TEA PARTY\n      </h2>\n\n    </div>\n\n    <div class=\"body-copy\">\n\n      <p>\n        A weekly gathering for mathematics,\n        puzzles, conversation, and tea.\n      </p>\n\n      <p class=\"small-caps\">\n        12:45 PM / PS 255\n      </p>\n\n      <a class=\"text-link\" href=\"./tea/\">\n        ENTER THE ARCHIVE ↗\n      </a>\n\n    </div>\n\n  </section>\n<!-- =====================================================\n     FIG. 03 / SIAM NETWORK\n     ===================================================== -->\n\n<section class=\"network-section\">\n\n  <div class=\"fig-label\">\n    FIG. 03 / CHAPTER NETWORK\n  </div>\n\n  <h2>\n    THE SIAM NETWORK\n  </h2>\n\n\n  <div class=\"chapter-graph\">\n\n    <svg\n      class=\"network-svg\"\n      viewBox=\"0 0 1000 430\"\n      xmlns=\"http://www.w3.org/2000/svg\"\n      role=\"img\"\n      aria-labelledby=\"network-title network-desc\"\n    >\n\n      <title id=\"network-title\">\n        Illinois SIAM student chapter network\n      </title>\n\n      <desc id=\"network-desc\">\n        Illinois Tech, Loyola, Northwestern, and UIUC\n        connected within the broader SIAM organization.\n      </desc>\n\n\n      <!-- SIAM ORGANIZATIONAL CONNECTIONS -->\n\n      <g class=\"siam-edges\">\n\n        <line x1=\"180\" y1=\"210\" x2=\"500\" y2=\"370\" />\n        <line x1=\"455\" y1=\"230\" x2=\"500\" y2=\"370\" />\n        <line x1=\"690\" y1=\"115\" x2=\"500\" y2=\"370\" />\n        <line x1=\"810\" y1=\"255\" x2=\"500\" y2=\"370\" />\n\n      </g>\n\n\n      <!-- LOCAL CHAPTER CONNECTIONS -->\n\n      <g class=\"chapter-edges\">\n\n        <line x1=\"180\" y1=\"210\" x2=\"455\" y2=\"230\" />\n        <line x1=\"180\" y1=\"210\" x2=\"690\" y2=\"115\" />\n        <line x1=\"455\" y1=\"230\" x2=\"690\" y2=\"115\" />\n        <line x1=\"455\" y1=\"230\" x2=\"810\" y2=\"255\" />\n        <line x1=\"690\" y1=\"115\" x2=\"810\" y2=\"255\" />\n\n      </g>\n\n\n      <!-- LOYOLA -->\n\n      <g class=\"network-node\">\n\n        <circle cx=\"180\" cy=\"210\" r=\"7\" />\n\n        <text\n          x=\"180\"\n          y=\"238\"\n          text-anchor=\"middle\"\n        >\n          LOYOLA\n        </text>\n\n      </g>\n\n\n      <!-- IIT -->\n\n      <g class=\"network-node network-node-iit\">\n\n        <circle cx=\"455\" cy=\"230\" r=\"10\" />\n\n        <text\n          x=\"455\"\n          y=\"260\"\n          text-anchor=\"middle\"\n        >\n          IIT\n        </text>\n\n        <text\n          class=\"network-sub-label\"\n          x=\"455\"\n          y=\"279\"\n          text-anchor=\"middle\"\n        >\n          YOU ARE HERE\n        </text>\n\n      </g>\n\n\n      <!-- NORTHWESTERN -->\n\n      <g class=\"network-node\">\n\n        <circle cx=\"690\" cy=\"115\" r=\"7\" />\n\n        <text\n          x=\"690\"\n          y=\"91\"\n          text-anchor=\"middle\"\n        >\n          NORTHWESTERN\n        </text>\n\n      </g>\n\n\n      <!-- UIUC -->\n\n      <g class=\"network-node\">\n\n        <circle cx=\"810\" cy=\"255\" r=\"7\" />\n\n        <text\n          x=\"810\"\n          y=\"284\"\n          text-anchor=\"middle\"\n        >\n          UIUC\n        </text>\n\n      </g>\n\n\n      <!-- SIAM -->\n\n      <g class=\"network-node\">\n\n        <circle cx=\"500\" cy=\"370\" r=\"8\" />\n\n        <text\n          x=\"500\"\n          y=\"400\"\n          text-anchor=\"middle\"\n        >\n          SIAM\n        </text>\n\n      </g>\n\n    </svg>\n\n  </div>\n\n\n  <div class=\"vertex-count\">\n    |V| &gt; 175\n  </div>\n\n  <div class=\"vertex-caption\">\n    STUDENT CHAPTERS WORLDWIDE\n  </div>\n\n\n  <div class=\"network-cta\">\n    <a class=\"text-link\" href=\"./siam.html\">\n      WHY THAT MATTERS ↗\n    </a>\n  </div>\n\n</section>\n\n  <!-- =====================================================\n       FOOTER\n       ===================================================== -->\n\n  <footer class=\"site-footer\">\n\n    <span>\n      SIAM @ IIT / CHICAGO, IL\n    </span>\n\n    <div>\n      <a href=\"./archive.html\">ARCHIVE</a>\n      <a href=\"#\">INSTAGRAM ↗</a>\n      <a href=\"#\">LINKEDIN ↗</a>\n    </div>\n\n  </footer>\n\n</div>\n\n<script src=\"./fun.js?v=4\"></script>\n```","srcMarkdownNoYaml":""},"formats":{"html":{"identifier":{"display-name":"HTML","target-format":"html","base-format":"html"},"execute":{"fig-width":7,"fig-height":5,"fig-format":"retina","fig-dpi":96,"df-print":"default","error":false,"eval":true,"cache":null,"free